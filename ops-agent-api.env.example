# Copy this file to ops-agent-api.env (NOT committed to git) and fill in
# real values. Referenced by ops-agent-api.service via EnvironmentFile=.
# This sidecar is a tiny read/write HTTP API over ops-agent-config.yaml
# and the agent's state/log files - it's what the ops-ui container talks
# to, since the UI runs in a container on a different host than the
# agent's own files. It has NO business being reachable from anywhere
# except that UI container - restrict it at your firewall (see README),
# the token below is defense in depth on top of that, not instead of it.

# Required: any long random string, shared with ops-ui's .env
OPS_AGENT_API_TOKEN=

# Optional
OPS_AGENT_API_PORT=8099
