# Copy this file to ops-agent.env (NOT committed to git) and fill in real
# values. Referenced by ops-agent.service via EnvironmentFile=.

# Required: a Home Assistant long-lived access token. Still used for HA's
# own health/update checks (update.* entities) - NOT for notifications
# anymore, those go through ntfy now, configured in ops-agent-config.yaml
# (see config.example.yaml), intentionally kept separate from HA.
OPS_AGENT_HA_TOKEN=

# Optional - defaults shown / overridden by ops-agent-config.yaml if set there
OPS_AGENT_HA_BASE=https://your-ha-instance.example
OPS_AGENT_OLLAMA_URL=http://your-ollama-host:11434/api/chat
OPS_AGENT_MODEL=gemma4:31b
OPS_AGENT_CONFIG_FILE=/root/ops-agent-config.yaml

# Required if you're running ops_agent_chat.py (the admin UI's Chat tab) -
# it shares this same env file since it imports ops_agent.py directly.
# Shared secret with the UI - must match OPS_AGENT_CHAT_TOKEN in ops-ui/.env.
OPS_AGENT_CHAT_TOKEN=
OPS_AGENT_CHAT_PORT=8100

# Hosts the agent reaches over SSH, and local paths (placeholders shown)
OPS_AGENT_WORKSTATION_SSH=user@workstation.example
OPS_AGENT_QNAP_SSH=admin@nas.example
OPS_AGENT_QNAP_HOST=nas.example
OPS_AGENT_WORKSTATION_BACKUP_DIR=/home/user/ops-agent-backups
OPS_AGENT_IMMICH_GATE=~/bin/immich-gate
