# Copy to .env (NOT committed to git) alongside docker-compose.yml in this
# directory. docker compose reads .env automatically for variable
# substitution.

# Base URL of the ops-agent-api sidecar (runs on the SAME host as
# ops_agent.py itself, not this UI's host) - e.g. http://<proxmox-ip>:8099
OPS_AGENT_API_BASE=

# Must match OPS_AGENT_API_TOKEN in ops-agent-api.env exactly
OPS_AGENT_API_TOKEN=

# Base URL of the ops-agent-chat sidecar - same host as ops_agent.py,
# different port (default 8100) - e.g. http://<proxmox-ip>:8100
OPS_AGENT_CHAT_BASE=

# Must match OPS_AGENT_CHAT_TOKEN in ops-agent.env exactly (chat shares
# ops_agent.py's own env file, since it imports ops_agent.py directly -
# see ops_agent_chat.py's module docstring for why)
OPS_AGENT_CHAT_TOKEN=

# GitHub OAuth app credentials - gates this whole panel, since it can
# restart/update containers and (via chat) run any allowed tool call, and
# its port is reachable directly on the LAN, not just through whatever
# reverse-proxy/access-list fronts it. Create a GitHub OAuth App (GitHub
# Settings -> Developer settings -> OAuth Apps), set its callback URL to
# match OAUTH_REDIRECT_URI below exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Initial GitHub username allowed to log in - ONE-TIME SEED only, used to
# populate the real user list (managed on the Config tab -> "Login
# access", persisted server-side by ops_agent_api.py) the first time it's
# empty. After that, this value is never read again - add/remove GitHub
# accounts from the UI instead. Safe to leave set permanently as a
# lockout safety net: if the managed list is ever emptied out entirely,
# the next page load re-seeds from this.
GITHUB_ALLOWED_LOGIN=

# Must exactly match the callback URL configured in the GitHub OAuth App,
# and be reachable from wherever you log in from - e.g. https://agent.example.com/
OAUTH_REDIRECT_URI=

# Initial username/password fallback login - same ONE-TIME SEED deal as
# GITHUB_ALLOWED_LOGIN above (managed from the UI after that, under
# Config -> "Login access" -> "Username / password", where you can add
# more without ever touching this file again). The fallback login only
# appears on the login page at all if at least one basic-auth user
# exists - for when GitHub itself is unreachable (no internet, GitHub
# outage) and you still need in over the LAN.
#
# BASIC_AUTH_PASSWORD_HASH is never your plaintext password - generate it
# yourself (see README.md's Admin UI section for the one-liner, which
# prompts for the password interactively rather than taking it as a
# command-line arg) and paste the printed value here.
#
# No brute-force rate limiting on this path - it leans on this panel
# already being LAN-only/firewalled and a strong generated password.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD_HASH=
